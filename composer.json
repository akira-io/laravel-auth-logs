{
  "name": "akira/laravel-auth-logs",
  "description": "Track, query, and act on authentication activity in your Laravel application. Automatically records successful and failed sign-ins, with optional notifications and geolocation context.",
  "keywords": [
    "Akira",
    "laravel",
    "laravel-auth-logs"
  ],
  "homepage": "https://github.com/akira-io/laravel-auth-logs",
  "license": "MIT",
  "authors": [
    {
      "name": "kidiatoliny",
      "email": "kidiatoliny@akira-io.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.4",
    "illuminate/contracts": "^12.0 | ^13.0",
    "pinkary-project/type-guard": "^0.1.0",
    "spatie/laravel-package-tools": "^1.92.4"
  },
  "require-dev": {
    "akira/laravel-debugger": "^1.0",
    "larastan/larastan": "^3.4",
    "laravel/pint": "^1.22",
    "nunomaduro/collision": "^8.8.0",
    "orchestra/testbench": "^10.2.2|^11.0",
    "pestphp/pest": "^3.8.2",
    "pestphp/pest-plugin-arch": "^3.1.1",
    "pestphp/pest-plugin-laravel": "^3.2",
    "pestphp/pest-plugin-type-coverage": "^3.5.1",
    "phpstan/extension-installer": "^1.4.3",
    "phpstan/phpstan-deprecation-rules": "^2.0.2",
    "phpstan/phpstan-phpunit": "^2.0.6",
    "rector/rector": "^2.0.14"
  },
  "autoload": {
    "psr-4": {
      "Akira\\LaravelAuthLogs\\": "src/",
      "Akira\\LaravelAuthLogs\\Database\\Factories\\": "database/factories/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Akira\\LaravelAuthLogs\\Tests\\": "tests/",
      "Workbench\\App\\": "workbench/app/"
    }
  },
  "scripts": {
    "post-autoload-dump": "@composer run prepare",
    "prepare": "@php vendor/bin/testbench package:discover --ansi",
    "analyse": "vendor/bin/phpstan analyse",
    "lint": [
      "rector",
      "pint"
    ],
    "test:lint": "pint --test",
    "test:refactor": "rector --dry-run",
    "test:types": "phpstan analyse ",
    "test:type-coverage": "pest --type-coverage --min=100 --compact",
    "test:coverage": "pest --parallel --coverage --exactly=100 --compact",
    "test": [
      "@test:lint",
      "@test:refactor",
      "@test:types",
      "@test:type-coverage",
      "@test:coverage"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Akira\\LaravelAuthLogs\\LaravelAuthLogsServiceProvider"
      ],
      "aliases": {
        "LaravelAuthLogs": "Akira\\LaravelAuthLogs\\Facades\\LaravelAuthLogs"
      }
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
